{
  "apiId": "display",
  "endpoints": [
    {
      "id": "displayRead",
      "sparqlURI": "http://localhost:8080/display/sparql",
      "graphURI": "urn:x-arq:DefaultGraph",
      "httpMethod": "GET",
      "authInfo": {
        "user": "",
        "password": "",
        "type": "basic"
      }
    }
  ],
  "model": [],
  "queryTemplates": [
    {
      "id": "getExhibitions",
      "description": "Get instances of exhibition.",
      "template": "SELECT DISTINCT ?exhibition ?label WHERE {?exhibition a <http://www.cidoc-crm.org/cidoc-crm/E7_Activity>;<http://www.cidoc-crm.org/cidoc-crm/P2_has_type> <http://vocab.getty.edu/aat/300054766>;<http://www.w3.org/2000/01/rdf-schema#label> ?label}",
      "variables": [
        "exhibition",
        "label"
      ],
      "parameters": [],
      "endpoint": "displayRead"
    },
    {
      "id": "getSetUsedbyExhibition",
      "description": "Get instances of set used by an exhibition.",
      "template": "SELECT DISTINCT ?exhib ?set WHERE{BIND(<{{{exhibition}}}> AS ?exhib) ?exhib <http://www.cidoc-crm.org/cidoc-crm/P16_used_specific_object> ?set.}",
      "variables": [
        "exhib",
        "set"
      ],
      "parameters": [
        {
          "label": "exhibition",
          "type": "iri",
          "optional": false
        }
      ],
      "endpoint": "displayRead"
    },
    {
      "id": "getExhibitsWithinExhibition",
      "description": "Get instances of exhibit used by an exhibition.",
      "template": "SELECT DISTINCT ?exhib ?exhibit WHERE {BIND(<{{{exhibition}}}> AS ?exhib) ?exhib <http://www.cidoc-crm.org/cidoc-crm/P16_used_specific_object> ?set. ?exhibit <https://linked.art/ns/terms/member_of> ?set.}",
      "variables": [
        "exhib",
        "set"
      ],
      "parameters": [
        {
          "label": "exhibition",
          "type": "iri",
          "optional": false
        }
      ],
      "endpoint": "displayRead"
    }
  ]
}