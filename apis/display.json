{
  "apiId": "display",
  "endpoints": [
    {
      "id": "/display/sparql",
      "sparqlURI": "http://localhost:8080/display/sparql",
      "graphURI": "urn:x-arq:DefaultGraph",
      "httpMethod": "GET",
      "authInfo": {
        "user": "",
        "password": "",
        "type": "basic"
      }
    }
  ],
  "model": [
    {
      "id": "exhibition",
      "oprops": [
        {
          "label": "classified_as",
          "iri": "http://www.cidoc-crm.org/cidoc-crm/P2_has_type",
          "endpoint": "/display/sparql"
        },
        {
          "label": "used_specific_object",
          "targetId": "set",
          "embed": true,
          "iri": "http://www.cidoc-crm.org/cidoc-crm/P16_used_specific_object",
          "endpoint": "/display/sparql"
        }
      ],
      "dprops": [
        {
          "label": "_label",
          "iri": "http://www.w3.org/2000/01/rdf-schema#label",
          "endpoint": "/display/sparql"
        },
        {
          "label": "identified_by",
          "iri": "http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by>/<http://www.cidoc-crm.org/cidoc-crm/P190_has_symbolic_content",
          "endpoint": "/display/sparql"
        }
      ],
      "types": [
        {
          "label": "type",
          "restrictions": [
            "FILTER (?type NOT IN ( <http://www.w3.org/2002/07/owl#Thing>, <http://www.w3.org/2000/01/rdf-schema#Resource> ))"
          ],
          "endpoint": "/display/sparql"
        }
      ]
    },
    {
      "id": "set",
      "oprops": [
      ],
      "dprops": [
        {
          "label": "_label",
          "iri": "http://www.w3.org/2000/01/rdf-schema#label",
          "endpoint": "/display/sparql"
        },
        {
          "label": "referred_to_by",
          "iri": "http://www.cidoc-crm.org/cidoc-crm/P67i_is_referred_to_by>/<http://www.cidoc-crm.org/cidoc-crm/P190_has_symbolic_content",
          "endpoint": "/display/sparql"
        }
      ],
      "types": [
        {
          "label": "type",
          "restrictions": [
            "FILTER (?type NOT IN ( <http://www.w3.org/2002/07/owl#Thing>, <http://www.w3.org/2000/01/rdf-schema#Resource> ))"
          ],
          "endpoint": "/display/sparql"
        }
      ]
    },
    {
      "id": "exhibitsSet",
      "oprops": [
        {
          "label": "member",
          "iri": "https://linked.art/ns/terms/has_member",
          "endpoint": "/display/sparql"
        }
      ],
      "dprops": [
        {
          "label": "_label",
          "iri": "http://www.w3.org/2000/01/rdf-schema#label",
          "endpoint": "/display/sparql"
        },
        {
          "label": "referred_to_by",
          "iri": "http://www.cidoc-crm.org/cidoc-crm/P67i_is_referred_to_by>/<http://www.cidoc-crm.org/cidoc-crm/P190_has_symbolic_content",
          "endpoint": "/display/sparql"
        }
      ],
      "types": [
        {
          "label": "type",
          "restrictions": [
            "FILTER (?type NOT IN ( <http://www.w3.org/2002/07/owl#Thing>, <http://www.w3.org/2000/01/rdf-schema#Resource> ))"
          ],
          "endpoint": "/display/sparql"
        }
      ]
    },
    {
      "id": "exhibit",
      "oprops": [
        {
          "label": "has_topological_relation_with",
          "iri": "https://w3id.org/display#hasTopologicalRelationWith",
          "endpoint": "/display/sparql"
        }
      ],
      "dprops": [
        {
          "label": "_label",
          "iri": "http://www.w3.org/2000/01/rdf-schema#label",
          "endpoint": "/display/sparql"
        }
      ],
      "types": [
        {
          "label": "type",
          "restrictions": [
            "FILTER (?type NOT IN ( <http://www.w3.org/2002/07/owl#Thing>, <http://www.w3.org/2000/01/rdf-schema#Resource> ))"
          ],
          "endpoint": "/display/sparql"
        }
      ]
    },{
      "id": "exhibitionSpaces",
      "oprops": [
        {
          "label": "spaces",
          "iri": "http://www.cidoc-crm.org/cidoc-crm/P16_used_specific_object>/<https://linked.art/ns/terms/has_member>^<https://w3id.org/display#hasExhibit",
          "targetId": "space",
          "endpoint": "/display/sparql"
        }
      ],
      "dprops": [
        {
          "label": "_label",
          "iri": "http://www.w3.org/2000/01/rdf-schema#label",
          "endpoint": "/display/sparql"
        }
      ],
      "types": [
        {
          "label": "type",
          "restrictions": [
            "FILTER (?type NOT IN ( <http://www.w3.org/2002/07/owl#Thing>, <http://www.w3.org/2000/01/rdf-schema#Resource> ))"
          ],
          "endpoint": "/display/sparql"
        }
      ]
    },{
      "id": "space",
      "oprops": [
        {
          "label": "has_exhibit",
          "iri": "https://w3id.org/display#hasExhibit",
          "targetId": "exhibit",
          "endpoint": "/display/sparql"
        },{
          "label": "adjacent_zone",
          "iri": "https://w3id.org/bot#adjacentZone",
          "targetId": "zone",
          "endpoint": "/display/sparql"
        },{
          "label": "intersects_zone",
          "iri": "https://w3id.org/bot#intersectsZone",
          "targetId": "zone",
          "endpoint": "/display/sparql"
        },{
          "label": "has_exhibition_space",
          "iri": "https://w3id.org/display#hasExhibitionSpace",
          "targetId": "zone",
          "endpoint": "/display/sparql"
        }
      ],
      "dprops": [
        {
          "label": "_label",
          "iri": "http://www.w3.org/2000/01/rdf-schema#label",
          "endpoint": "/display/sparql"
        }
      ],
      "types": [
        {
          "label": "type",
          "restrictions": [
            "FILTER (?type NOT IN ( <http://www.w3.org/2002/07/owl#Thing>, <http://www.w3.org/2000/01/rdf-schema#Resource> ))"
          ],
          "endpoint": "/display/sparql"
        }
      ]
    }
  ],
  "queryTemplates": [
    {
      "id": "exhibitions",
      "description": "Get all instances of exhibition.",
      "template": "SELECT DISTINCT ?exhibition ?label WHERE {?exhibition a <http://www.cidoc-crm.org/cidoc-crm/E7_Activity>;<http://www.cidoc-crm.org/cidoc-crm/P2_has_type> <http://vocab.getty.edu/aat/300054766>;<http://www.w3.org/2000/01/rdf-schema#label> ?label}",
      "variables": [
        "exhibition",
        "label"
      ],
      "parameters": [],
      "endpoint": "/display/sparql"
    },
    {
      "id": "exhibitWithSpecificRelations",
      "endpoint": "/display/sparql",
      "description": "Get an exhibit with its specific topological relationships.",
      "template": "SELECT ?exhibit ?relation ?object WHERE {BIND(<{{{iri}}}> AS ?exhibit) ?exhibit ?relation ?object. ?relation <http://www.w3.org/2000/01/rdf-schema#subPropertyOf>+ <https://w3id.org/display#hasTopologicalRelationWith>. FILTER (?relation != <https://w3id.org/display#hasTopologicalRelationWith>) FILTER (?relation != <https://w3id.org/display#spatialRelationship>) FILTER (?relation != <https://w3id.org/display#proximalRelationship>)}",
      "variables": [
        "exhibit",
        "relation",
        "object"
      ],
      "parameters": [
        {
          "label": "iri",
          "type": "iri",
          "optional": false
        }
      ]
    }
  ]
}