  "queryTemplates": [
    {
      "id": "exhibitions",
      "description": "Get all instances of exhibition.",
      "template": "SELECT DISTINCT ?exhibition ?label WHERE {?exhibition a <http://www.cidoc-crm.org/cidoc-crm/E7_Activity>;<http://www.cidoc-crm.org/cidoc-crm/P2_has_type> <http://vocab.getty.edu/aat/300054766>;<http://www.w3.org/2000/01/rdf-schema#label> ?label}",
      "variables": [
        "exhibition",
        "label"
      ],
      "parameters": [],
      "endpoint": "/display/sparql"
    },
    {
      "id": "exhibitWithSpecificRelations",
      "endpoint": "/display/sparql",
      "description": "Get an exhibit with its specific topological relationships.",
      "template": "SELECT ?exhibit ?relation ?object WHERE {BIND(<{{{iri}}}> AS ?exhibit) ?exhibit ?relation ?object. ?relation <http://www.w3.org/2000/01/rdf-schema#subPropertyOf>+ <https://w3id.org/display#hasTopologicalRelationWith>. FILTER (?relation != <https://w3id.org/display#hasTopologicalRelationWith>) FILTER (?relation != <https://w3id.org/display#spatialRelationship>) FILTER (?relation != <https://w3id.org/display#proximalRelationship>)}",
      "variables": [
        "exhibit",
        "relation",
        "object"
      ],
      "parameters": [
        {
          "label": "iri",
          "type": "iri",
          "optional": false
        }
      ]
    }
  ]
